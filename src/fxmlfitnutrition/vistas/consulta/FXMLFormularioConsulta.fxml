<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="610.0" prefWidth="650.0" stylesheets="@../../css/light-modern.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxmlfitnutrition.vistas.consulta.FXMLFormularioConsultaController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" styleClass="label-title" text="Registrar Consulta Medica">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>

      <GridPane hgap="15.0" layoutX="30.0" layoutY="70.0" prefHeight="440.0" prefWidth="590.0" vgap="14.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="58.0" vgrow="NEVER" />
            <RowConstraints minHeight="10.0" prefHeight="58.0" vgrow="NEVER" />
            <RowConstraints minHeight="10.0" prefHeight="58.0" vgrow="NEVER" />
            <RowConstraints minHeight="10.0" prefHeight="58.0" vgrow="NEVER" />
            <RowConstraints minHeight="10.0" prefHeight="120.0" vgrow="ALWAYS" />
         </rowConstraints>
         <children>
            <VBox>
               <children>
                  <Label text="Paciente *" />
                  <ComboBox fx:id="cbPaciente" prefWidth="285.0" />
               </children>
            </VBox>
            <VBox GridPane.columnIndex="1">
               <children>
                  <Label text="Cita asociada (opcional)" />
                  <ComboBox fx:id="cbCitaAsociada" prefWidth="285.0" />
               </children>
            </VBox>
            <VBox GridPane.rowIndex="1">
               <children>
                  <Label text="Peso (kg) *" />
                  <Spinner fx:id="spPeso" editable="true" prefWidth="285.0" />
               </children>
            </VBox>
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label text="Estatura (m) *" />
                  <Spinner fx:id="spTalla" editable="true" prefWidth="285.0" />
               </children>
            </VBox>
            <VBox GridPane.rowIndex="2">
               <children>
                  <Label text="IMC" />
                  <Label fx:id="lbIMC" prefHeight="36.0" styleClass="label-imc" text="0.00" />
               </children>
            </VBox>
            <VBox GridPane.columnSpan="2" GridPane.rowIndex="3">
               <children>
                  <Label text="Dieta asignada" />
                  <ComboBox fx:id="cbDietaAsignada" prefWidth="590.0" />
               </children>
            </VBox>
            <VBox GridPane.columnSpan="2" GridPane.rowIndex="4">
               <children>
                  <Label text="Observaciones" />
                  <TextArea fx:id="taObservaciones" prefHeight="105.0" prefWidth="590.0" wrapText="true" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" layoutX="30.0" layoutY="540.0" prefHeight="40.0" prefWidth="590.0" spacing="15.0">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#clicCancelar" prefWidth="120.0" text="Cancelar" />
            <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#clicRegistrar" prefWidth="120.0" styleClass="button-primary" text="Registrar" />
         </children>
      </HBox>
   </children>
</AnchorPane>
