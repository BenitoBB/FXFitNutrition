<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="677.0" prefWidth="1030.0" stylesheets="@../../css/light-modern.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxmlfitnutrition.vistas.consulta.FXMLConsultasController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" styleClass="label-title" text="Gestión de Consultas">
         <font><Font name="System Bold" size="22.0" /></font>
      </Label>

      <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="70.0" prefHeight="50.0" prefWidth="970.0" spacing="15.0">
         <children>
            <ComboBox fx:id="cbPaciente" prefHeight="40.0" prefWidth="330.0" promptText="Todos los pacientes" />
            <DatePicker fx:id="dpFechaConsulta" prefHeight="40.0" prefWidth="210.0" promptText="Todas las fechas" />
            <Button fx:id="btnLimpiarFechas" mnemonicParsing="false" onAction="#clicLimpiarFechas" prefHeight="40.0" text="Limpiar Fechas" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <TableView fx:id="tvConsultas" layoutX="30.0" layoutY="140.0" prefHeight="470.0" prefWidth="970.0">
         <columns>
            <TableColumn fx:id="colFecha" prefWidth="105.0" text="Fecha" />
            <TableColumn fx:id="colHora" prefWidth="75.0" text="Hora" />
            <TableColumn fx:id="colPaciente" prefWidth="190.0" text="Paciente" />
            <TableColumn fx:id="colPeso" prefWidth="80.0" text="Peso" />
            <TableColumn fx:id="colTalla" prefWidth="85.0" text="Estatura" />
            <TableColumn fx:id="colIMC" prefWidth="75.0" text="IMC" />
            <TableColumn fx:id="colDieta" prefWidth="160.0" text="Dieta" />
            <TableColumn fx:id="colEstatus" prefWidth="95.0" text="Estatus" />
            <TableColumn fx:id="colObservaciones" prefWidth="105.0" text="Observaciones" />
         </columns>
      </TableView>
      <Button fx:id="btnModificar" layoutX="560.0" layoutY="623.0" mnemonicParsing="false" onAction="#clicModificar" prefHeight="40.0" styleClass="button-edit" text="Modificar" />
      <Button fx:id="btnCancelarConsulta" layoutX="671.0" layoutY="623.0" mnemonicParsing="false" onAction="#clicCancelarConsulta" prefHeight="40.0" styleClass="button-danger" text="Cancelar Consulta" />
      <Button fx:id="btnRegistrar" layoutX="837.0" layoutY="623.0" mnemonicParsing="false" onAction="#clicRegistrar" prefHeight="40.0" styleClass="button-primary" text="Registrar Consulta" />
   </children>
</AnchorPane>
