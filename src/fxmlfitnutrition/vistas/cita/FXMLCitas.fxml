<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="660.0" prefWidth="1030.0" stylesheets="@css/light-modern.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxmlfitnutrition.vistas.cita.FXMLCitasController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" styleClass="label-title" text="Gestión de Citas">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="70.0" prefHeight="50.0" prefWidth="970.0" spacing="15.0">
         <children>
            <TextField fx:id="tfBuscar" prefHeight="40.0" prefWidth="390.0" promptText="Buscar cita por nombre o correo del paciente..." />
            <ComboBox fx:id="cbFiltroEstatus" prefHeight="40.0" prefWidth="190.0" promptText="Estatus" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAgendar" mnemonicParsing="false" onAction="#clicAgendarCita" prefHeight="40.0" styleClass="button-primary" text="Agendar Cita" />
         </children>
      </HBox>

      <TableView fx:id="tvCitas" layoutX="30.0" layoutY="140.0" prefHeight="420.0" prefWidth="970.0">
         <columns>
            <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha" />
            <TableColumn fx:id="colHora" prefWidth="120.0" text="Hora" />
            <TableColumn fx:id="colPaciente" prefWidth="280.0" text="Paciente" />
            <TableColumn fx:id="colMedico" prefWidth="280.0" text="Medico" />
            <TableColumn fx:id="colEstatus" prefWidth="150.0" text="Estatus" />
         </columns>
      </TableView>

      <HBox alignment="CENTER_RIGHT" layoutX="30.0" layoutY="580.0" prefHeight="50.0" prefWidth="970.0" spacing="15.0">
         <children>
            <Button fx:id="btnModificar" mnemonicParsing="false" onAction="#clicModificar" prefHeight="40.0" styleClass="button-edit" text="Modificar" />
            <Button fx:id="btnReagendar" mnemonicParsing="false" onAction="#clicReagendar" prefHeight="40.0" styleClass="button-update" text="Reagendar" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="40.0" styleClass="button-danger" text="Cancelar" />
         </children>
      </HBox>
   </children>
</AnchorPane>
