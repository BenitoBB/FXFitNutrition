<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="660.0" prefWidth="1030.0" stylesheets="@../../css/light-modern.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxmlfitnutrition.vistas.alimento.FXMLAlimentosController">
   <children>
      <Label layoutX="30.0" layoutY="20.0" styleClass="label-title" text="Catálogo de Alimentos">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="70.0" prefHeight="50.0" prefWidth="970.0" spacing="12.0">
         <children>
            <TextField fx:id="tfBuscar" prefHeight="40.0" prefWidth="320.0" promptText="Buscar alimento" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#clicNuevo" prefHeight="40.0" styleClass="button-primary" text="Nuevo Alimento" />
            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#clicEditar" prefHeight="40.0" styleClass="button-edit" text="Editar" />
         </children>
      </HBox>

      <TableView fx:id="tvAlimentos" layoutX="30.0" layoutY="140.0" prefHeight="470.0" prefWidth="970.0">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="420.0" text="Alimento" />
            <TableColumn fx:id="colPorcion" prefWidth="240.0" text="Porción" />
            <TableColumn fx:id="colCalorias" prefWidth="290.0" text="Calorías por porción" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
