<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="360.0" prefWidth="560.0" stylesheets="@../../css/light-modern.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxmlfitnutrition.vistas.alimento.FXMLFormularioAlimentoController">
   <children>
      <Label fx:id="lbTitulo" layoutX="30.0" layoutY="20.0" styleClass="label-title" text="Nuevo Alimento">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <GridPane hgap="12.0" layoutX="30.0" layoutY="80.0" prefWidth="500.0" vgap="14.0">
         <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="140.0" prefWidth="150.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" prefWidth="340.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="38.0" />
            <RowConstraints minHeight="38.0" />
            <RowConstraints minHeight="38.0" />
         </rowConstraints>
         <children>
            <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="tfNombreAlimento" prefHeight="38.0" promptText="Ej. Manzana" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Porcion" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cbPorcion" prefHeight="38.0" prefWidth="340.0" promptText="Selecciona porcion" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Calorias" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Spinner fx:id="spCaloriasPorcion" editable="true" prefHeight="38.0" prefWidth="160.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" layoutX="30.0" layoutY="280.0" prefHeight="50.0" prefWidth="500.0" spacing="12.0">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="40.0" styleClass="button-secondary" text="Cancelar" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="40.0" styleClass="button-primary" text="Guardar" />
         </children>
      </HBox>
   </children>
</AnchorPane>
